# PixelDeck settings. Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore: it holds your token, never commit it.
# Anything set in the real environment wins over this file. The packaged app needs no copy:
# its setup screen (Settings, Setup) writes the settings for you.

# ---------------------------------------------------------------- Bitbucket (required)
# An Atlassian API token with Bitbucket scopes: https://id.atlassian.com/manage-profile/security/api-tokens
# It needs read access to your user, the workspace, repositories and pull requests, plus pull
# request write to open, merge and decline pull requests from PixelDeck, and repository write to
# commit a file edited in the Repos panel. Never admin or delete scopes:
# deleting a pushed branch goes through git with your own credentials.
BITBUCKET_EMAIL=you@example.com
BITBUCKET_TOKEN=
# The workspace slug, as in https://bitbucket.org/<workspace>/<repo>
BITBUCKET_WORKSPACE=

# ---------------------------------------------------------------- GitHub or GitLab (instead of Bitbucket)
# Where your pull requests live: bitbucket (the default), github or gitlab. One at a time; each
# keeps its own settings below, so switching back loses nothing. Read only for now on GitHub and GitLab.
PIXELDECK_CODE_HOST=
# A GitHub personal access token: fine-grained, with read access to Pull requests, Contents and
# Metadata on your repositories (https://github.com/settings/personal-access-tokens/new), or classic
# with repo (and read:org for the team list).
GITHUB_TOKEN=
# GitHub Enterprise: https://<your server>/api/v3. Empty: https://api.github.com
GITHUB_URL=
# Keep to one organization and offer its members for your team. Empty: every repository the token sees.
GITHUB_ORG=
# A GitLab personal access token with the read_api scope.
GITLAB_TOKEN=
# Your own GitLab server. Empty: https://gitlab.com
GITLAB_URL=
# Keep to one group (and its subgroups) and offer its members for your team.
GITLAB_GROUP=

# ---------------------------------------------------------------- scope (optional)
# Show one project only (its key, such as WEB). Empty: every project. You can switch in the app.
BITBUCKET_PROJECT=

# ---------------------------------------------------------------- tickets (optional)
# Your Jira site, so ticket keys in branch names and titles become links.
JIRA_SITE=
# To see and move a ticket's status when you merge: an Atlassian API token with Jira access
# (read and write of issues). The Bitbucket token is never sent to Jira. JIRA_EMAIL defaults
# to BITBUCKET_EMAIL.
JIRA_TOKEN=
JIRA_EMAIL=
# Project keys that count as tickets, comma separated (ABC,XYZ). Empty: any KEY-123 shape,
# which can mistake other words for tickets, so set it when you can.
TICKET_PREFIXES=

# ---------------------------------------------------------------- music (optional)
# The Music panel plays your Spotify. Create an app at https://developer.spotify.com/dashboard
# (Web API), add the redirect URI the panel shows (http://127.0.0.1:<port>/spotify/callback,
# with the port PixelDeck runs on), and put the app's Client ID here. No client secret is
# needed. Picked up without a restart. Spotify Premium is needed to control playback.
SPOTIFY_CLIENT_ID=

# ---------------------------------------------------------------- your machine (optional)
# The folder that holds your local clones (used for "pushed, no PR", worktrees and the
# terminal's starting folder). Default: the folder PixelDeck itself sits in.
PIXELDECK_WORKSPACE_ROOT=
# Repos whose pull requests go to master or main before develop, as glob patterns.
PIXELDECK_RELEASE_REPOS=
# The Claude Code CLI, when it is not on PATH.
PIXELDECK_CLAUDE=
# Your own Claude brief templates (any of head.md, summarize.md, review.md, fix.md,
# fix_push.md); a file you leave out comes from briefs/.
PIXELDECK_BRIEFS_DIR=
# Open Bitbucket and Jira links with this command instead of the default browser,
# for example: firefox --new-tab
PIXELDECK_BROWSER=
# The local port.
PIXELDECK_PORT=8642

# ---------------------------------------------------------------- where PixelDeck keeps things (optional)
# Defaults: Linux ~/.cache/pixeldeck, ~/.local/state/pixeldeck, ~/.local/share/pixeldeck, ~/.config/pixeldeck
#           macOS ~/Library/Caches/PixelDeck and ~/Library/Application Support/PixelDeck
#           Windows %LOCALAPPDATA%\PixelDeck and %APPDATA%\PixelDeck
PIXELDECK_CACHE_DIR=
PIXELDECK_STATE_DIR=
PIXELDECK_DATA_DIR=
PIXELDECK_CONFIG_DIR=
# What the app saves for you (team list, chosen project). Default: <config dir>/settings.json
PIXELDECK_SETTINGS_FILE=
