# PixelDeck settings. Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore: it holds your token, never commit it.
# Anything set in the real environment wins over this file.

# ---------------------------------------------------------------- Bitbucket (required)
# An Atlassian API token with Bitbucket scopes: https://id.atlassian.com/manage-profile/security/api-tokens
# It needs read access to your user, the workspace, repositories and pull requests, plus pull
# request write to open, merge and decline pull requests from PixelDeck. Never admin or delete scopes:
# deleting a pushed branch goes through git with your own credentials.
BITBUCKET_EMAIL=you@example.com
BITBUCKET_TOKEN=
# The workspace slug, as in https://bitbucket.org/<workspace>/<repo>
BITBUCKET_WORKSPACE=

# ---------------------------------------------------------------- scope (optional)
# Show one project only (its key, such as WEB). Empty: every project. You can switch in the app.
BITBUCKET_PROJECT=

# ---------------------------------------------------------------- tickets (optional)
# Your Jira site, so ticket keys in branch names and titles become links.
JIRA_SITE=
# Project keys that count as tickets, comma separated (ABC,XYZ). Empty: any KEY-123 shape,
# which can mistake other words for tickets, so set it when you can.
TICKET_PREFIXES=

# ---------------------------------------------------------------- your machine (optional)
# The folder that holds your local clones (used for "pushed, no PR", worktrees and the
# terminal's starting folder). Default: the folder PixelDeck itself sits in.
PIXELDECK_WORKSPACE_ROOT=
# Repos whose pull requests go to master or main before develop, as glob patterns.
PIXELDECK_RELEASE_REPOS=
# The Claude Code CLI, when it is not on PATH.
PIXELDECK_CLAUDE=
# Your own Claude brief templates (any of head.md, summarize.md, review.md, fix.md,
# fix_push.md); a file you leave out comes from briefs/.
PIXELDECK_BRIEFS_DIR=
# Open Bitbucket and Jira links with this command instead of the default browser,
# for example: firefox --new-tab
PIXELDECK_BROWSER=
# The local port.
PIXELDECK_PORT=8642

# ---------------------------------------------------------------- where PixelDeck keeps things (optional)
# Defaults: Linux ~/.cache/pixeldeck, ~/.local/state/pixeldeck, ~/.local/share/pixeldeck, ~/.config/pixeldeck
#           macOS ~/Library/Caches/PixelDeck and ~/Library/Application Support/PixelDeck
#           Windows %LOCALAPPDATA%\PixelDeck and %APPDATA%\PixelDeck
PIXELDECK_CACHE_DIR=
PIXELDECK_STATE_DIR=
PIXELDECK_DATA_DIR=
PIXELDECK_CONFIG_DIR=
# What the app saves for you (team list, chosen project). Default: <config dir>/settings.json
PIXELDECK_SETTINGS_FILE=
